# ============================================================
# MedSource RAG Chatbot — Environment Configuration Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env   (macOS / Linux)
#   copy .env.example .env (Windows)
#
# NEVER commit .env to version control.
# This file contains ONLY safe placeholder values.
# ============================================================

# ------------------------------------------------------------
# Google Gemini API key (required)
# Free tier: 1,500 requests/day, 15 RPM — no billing needed.
# Get your free key at: https://aistudio.google.com/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.0-flash

# ------------------------------------------------------------
# Embedding model (do not change unless you re-embed)
# ------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_BATCH_SIZE=32

# ------------------------------------------------------------
# Retrieval settings
# ------------------------------------------------------------
TOP_K_DOCUMENTS=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.30
ENABLE_GENERAL_FALLBACK=true
ENABLE_QUERY_EXPANSION=false
ENABLE_RERANKER=false

# ------------------------------------------------------------
# Chunking (do not change unless you re-ingest)
# ------------------------------------------------------------
CHUNK_SIZE=256
CHUNK_OVERLAP=40

# ------------------------------------------------------------
# API server
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Key required to call this app's /query endpoint.
# Leave blank to disable auth (local dev only — NOT for public deployment).
CHATBOT_API_KEY=

# Password to unlock the Admin panel in the Streamlit UI (Data Sources tab).
# Leave blank to hide the admin panel entirely from all visitors.
ADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins (CORS)
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000,http://127.0.0.1:8501

# ------------------------------------------------------------
# LLM generation
# ------------------------------------------------------------
LLM_TEMPERATURE=0.1
MAX_TOKENS=1000

# ------------------------------------------------------------
# Paths
# ------------------------------------------------------------
VECTOR_STORE_PATH=./data/vector_store

# ------------------------------------------------------------
# PubMed ingestion (optional — used by scripts/pubmed_append.py)
# Provide any valid email address; NCBI requires it for E-utilities usage tracking.
# Example: PUBMED_EMAIL=yourname@example.com
# ------------------------------------------------------------
PUBMED_EMAIL=your-email@example.com

# ------------------------------------------------------------
# Live PubMed retrieval (optional augmentation at query time)
# When enabled, queries that fall below the confidence threshold
# also search PubMed live and merge results with local FAISS hits.
# ------------------------------------------------------------
ENABLE_LIVE_PUBMED=false

# NCBI API key (optional) — raises rate limit from 3 req/s to 10 req/s.
# Get a free key at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Timeout in seconds for live PubMed HTTP calls (default: 5).
LIVE_PUBMED_TIMEOUT_S=5

# Max abstracts to fetch per live query (default: 5, max recommended: 10).
LIVE_PUBMED_MAX_RESULTS=5
